# کدام موتور تولید ویدیو استفاده شود: mock (پیش‌فرض، بدون نیاز به API)، replicate یا pixverse
VIDEO_PROVIDER=mock

# --- فقط وقتی VIDEO_PROVIDER=replicate باشد لازم است ---
# توکن API اکانت Replicate خودت
REPLICATE_API_TOKEN=

# شناسه نسخه مدل متن‌به‌ویدیو روی Replicate (از صفحه مدل موردنظرت کپی کن)
REPLICATE_MODEL_VERSION=

# --- فقط وقتی VIDEO_PROVIDER=pixverse باشد لازم است ---
# کلید API اکانت PixVerse خودت (از platform.pixverse.ai)
PIXVERSE_API_KEY=

# اختیاری: مدل و کیفیت PixVerse (پیش‌فرض: v4.5 و 540p)
PIXVERSE_MODEL=v4.5
PIXVERSE_QUALITY=540p
